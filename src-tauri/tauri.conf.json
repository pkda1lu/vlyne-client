{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vlyne",
  "version": "3.0.0",
  "identifier": "com.vlyne.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Vlyne",
        "label": "main",
        "width": 1060,
        "height": 720,
        "minWidth": 940,
        "minHeight": 620,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "center": true,
        "backgroundColor": "#08090d",
        "windowEffects": {
          "effects": [
            "mica"
          ],
          "state": "followsWindowActiveState"
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "binaries/sing-box.exe": "core/sing-box.exe",
      "binaries/wintun.dll": "core/wintun.dll",
      "resources/rules/": "core/rules/"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": [
        "https://github.com/pkda1lu/vlyne-client/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNGRTFCNjg2OTgzNTE5RjcKUldUM0dUV1locmJoUDFQWGN5d1c4ZFdma1hLUXRvc0NkaXROUU9sMHpUSTlBNTBOQ2o2LzFvVzkK"
    }
  }
}
