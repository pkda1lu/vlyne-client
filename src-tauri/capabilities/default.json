{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities granted to the Vlyne main window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-is-maximized",
    "core:event:default",
    {
      "identifier": "opener:allow-open-url",
      "comment": "Payment pages, the bot and the support chat all open in the user's browser. The permission is worthless without a scope: without one every call is refused, which silently breaks checkout. Restricted to https so a link can never downgrade to plaintext, and the addresses themselves come from our own service.",
      "allow": [{ "url": "https://*" }]
    },
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "os:allow-platform",
    "os:allow-version",
    "process:allow-restart",
    "process:allow-exit",
    "updater:default",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled"
  ]
}
